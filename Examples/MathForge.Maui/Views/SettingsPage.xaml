<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="using:MathForge.Maui.ViewModels.Pages"
    xmlns:loc="using:MathForge.Maui.Resources.Localizations"
    x:Class="MathForge.Maui.Views.SettingsPage"
    x:DataType="pages:SettingsViewModel"
    Title="{x:Static loc:Components_Resources.Title_Settings}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="{x:Static loc:Components_Resources.Label_General}" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="16">
                <Image Source="appicon.png" WidthRequest="60" HeightRequest="60" />
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Кирилл Стародуб" />
                    <Label Text="kirillstarodub310@gmail.com" FontSize="12" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <Picker Title="{x:Static loc:Components_Resources.Label_Language}"
                    ItemsSource="{Binding AvailableLocales}"
                    SelectedItem="{Binding SelectedLocale, Mode=TwoWay}" />
            <Label Text="{x:Static loc:Components_Resources.Label_Visual}" FontAttributes="Bold" />
            <Picker Title="{x:Static loc:Components_Resources.Label_Theme}"
                    ItemsSource="{Binding AvailableThemes}"
                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
