

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:games="using:MathForge.Maui.ViewModels.Games"
             xmlns:commonModels1="using:MathForge.Maui.ViewModels.Common"
             xmlns:common1="using:MathForge.Maui.Views.Common"
             x:Class="MathForge.Maui.Views.Modules.GamesPage" 
             x:DataType="games:GamesViewModel"
             Title="Игры">
 <ContentPage.Content>
        <ScrollView Margin="4">
            <VerticalStackLayout Padding="16" Spacing="12">
                <!-- Tools -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="" 
                           FontAttributes="Bold" 
                           FontSize="20" 
                           Margin="0,16,0,4"/>
                
                    <BoxView HeightRequest="1" Color="Gray" HorizontalOptions="Fill"/>
                
                    <CollectionView
                        ItemsSource="{Binding Games}"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                Orientation="Vertical"
                                Span="3"
                                HorizontalItemSpacing="12"
                                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="commonModels1:PreviewViewModel">
                                <common1:PreviewSquareView />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
                
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>