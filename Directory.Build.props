<Project>

    <PropertyGroup>
        <ProjectTargetFrameworks>net10.0;net11.0</ProjectTargetFrameworks>
        <ProjectVersion>1.0.0</ProjectVersion>
        <ProjectAssemblyVersion>1.0.0.0</ProjectAssemblyVersion>
        <ProjectAuthors>NovoDwarf</ProjectAuthors>
        <ProjectCopyright>NovoDwarf</ProjectCopyright>
        <ProjectRepositoryUrl>https://github.com/NovoDwarf/MathForge</ProjectRepositoryUrl>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsPackable)' != 'false'">
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Authors>$(ProjectAuthors)</Authors>
        <Copyright>$(ProjectCopyright)</Copyright>
        <PackageProjectUrl>$(ProjectRepositoryUrl)</PackageProjectUrl>
        <RepositoryUrl>$(ProjectRepositoryUrl)</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.Core'">
        <Version>1.0.1-dev1</Version>
        <AssemblyVersion>1.0.1.1</AssemblyVersion>
        <FileVersion>1.0.1.1</FileVersion>
        <Description>Core contracts for MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.Mathematics'">
        <Version>1.0.0-dev3</Version>
        <AssemblyVersion>1.0.0.3</AssemblyVersion>
        <FileVersion>1.0.0.3</FileVersion>
        <Description>MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.Probability'">
        <Version>1.0.1-dev1</Version>
        <AssemblyVersion>1.0.1.1</AssemblyVersion>
        <FileVersion>1.0.1.1</FileVersion>
        <Description>Probability module from MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.Ballistics'">
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Description>Ballistics module from MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.Compression'">
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Description>Compression module from MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.Cryptography'">
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Description>Cryptography module from MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.DependencyInjection'">
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Description>Dependency injection module from MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.Graphics'">
        <Version>1.0.1-dev1</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Description>Graphics module from MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.MachineLearning'">
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Description>ML module from MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.Numerical'">
        <Version>1.0.1-dev2</Version>
        <AssemblyVersion>1.0.1.2</AssemblyVersion>
        <FileVersion>1.0.1.2</FileVersion>
        <Description>Numerical module from MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.Optimization'">
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Description>Optimization module from MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.Processing'">
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Description>Processing module from MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.SourceGenerators'">
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Description>Source generator module from MathForge</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MathForge.System'">
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Description>System module from MathForge</Description>
    </PropertyGroup>
</Project>
